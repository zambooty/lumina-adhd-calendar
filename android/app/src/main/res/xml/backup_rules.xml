<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (API ≤30): exclude app data so WebView / prefs with OAuth
  material are not copied to cloud backup. allowBackup=false is primary;
  these rules are defense-in-depth if backup is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
