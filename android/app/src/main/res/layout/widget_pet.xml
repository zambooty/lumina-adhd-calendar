<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_glass_bg">

    <TextView
        android:id="@+id/widget_pet_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_pet_kicker"
        android:textColor="#FFB020"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_pet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Blink"
        android:textColor="#3DFFD4"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_pet_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Companion"
        android:textColor="#C8D0DC"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
