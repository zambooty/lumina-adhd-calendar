<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_glass_bg">

    <TextView
        android:id="@+id/widget_agenda_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_agenda_kicker"
        android:textColor="#7DD3FC"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_agenda_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Upcoming · today"
        android:textColor="#F4F7FB"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_agenda_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nothing queued"
        android:textColor="#C8D0DC"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="6"
        android:ellipsize="end" />
</LinearLayout>
